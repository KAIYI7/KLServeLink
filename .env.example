# ==============================================================================
# KLServeLink — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for local development.
# NOTE: Never commit active secrets, credentials, or production keys to version control.
# ==============================================================================

# --- Python AI Batch Microservice (Cloud Run / Local) ---
PORT=8080
HOST=0.0.0.0

# Path to Google Cloud Service Account JSON key (for local execution only).
# On Cloud Run, Application Default Credentials (ADC) are resolved automatically.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Firebase Project Settings ---
FIREBASE_PROJECT_ID=your-firebase-project-id
